<?xml version="1.0" encoding="utf-8"?>
<!-- Private data belongs to this installation: transferred playlists can revive deleted state,
     folder grants cannot be restored, and copied alarm times must not arm another phone.
     allowBackup=false opts out of cloud backup; these rules also cover device transfer.
     Alarm data additionally uses device-protected noBackupFilesDir, excluded by every transport. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
