<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Playback has to survive the app leaving the screen: Android stops caring about a process
         with no visible components, and a foreground service is how you say this one is doing
         something the user asked for. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- API 33+. Without it the notification is suppressed; the service still runs, so playback
         works and only the controls are missing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Online catalogues: the index is downloaded once, then browsing works offline. The network
         is next needed when a track that is not cached is played. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_media_play"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Protracktor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Protracktor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Sharing a tune means handing another app a file it can read, and neither of the places
            our files live can do that: a document URI from the storage access framework belongs to
            the provider that issued it and we cannot pass on a grant we do not own, and a
            downloaded file is inside app-private storage that nothing else can see. So a share
            copies the bytes somewhere this provider can vouch for them.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shares"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
