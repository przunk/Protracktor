# Gradle / Android
.gradle/
build/
local.properties
*.iml
.cxx/
captures/
dist/

# Signing material never belongs in the repository
keystore.properties
*.jks
*.keystore

# Vendored native sources are fetched by scripts/fetch-native-deps.sh, not committed
native/vendor/

# Host probes: the sources and their generated config are committed, the objects and binaries are
# not. They are built by ./scripts/build-sc68-probes.sh and are host-specific.
native/probe/*/build/
native/probe/*/probe-*

# probe-extensions.py loads probe-uade.py as a module to reuse its index and download plumbing
# rather than copying it, and importlib leaves this behind.
scripts/__pycache__/

# IDE
.idea/
*.hprof

# OS
.DS_Store
Thumbs.db
