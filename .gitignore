# Gradle / Android
.gradle/
build/
local.properties
*.iml
.cxx/
captures/
dist/

# Signing material never belongs in the repository
keystore.properties
*.jks
*.keystore

# Vendored native sources are fetched by scripts/fetch-native-deps.sh, not committed
native/vendor/

# Host probes: the sources and their generated config are committed, the objects and binaries are
# not. They are built by ./scripts/build-sc68-probes.sh and are host-specific.
native/probe/*/build/
native/probe/*/probe-*

# probe-extensions.py loads probe-uade.py as a module to reuse its index and download plumbing
# rather than copying it, and importlib leaves this behind.
scripts/__pycache__/

# IDE
.idea/
*.hprof

# OS
.DS_Store
Thumbs.db

# Correspondence. Drafts and sent letters to the maintainers of libraries we use -- other people's
# names, other people's replies, and half-finished thoughts addressed to them by name. Useful to
# keep locally and not ours to publish.
#
# The five that were once committed were taken out of the history on 2026-09-05 and the
# correspondence in the commit messages paraphrased; this line is what stops the next one going in.
docs/letters/

# Written by scripts/serve-web.mjs on first run. Machine-specific: a port and the address the QR
# code advertises, which is different on every machine that runs it.
/server.json

# The owner's screenshots. He drops them in `user/` to show what a screen looks like -- they are how
# a bug report arrives here, not something the repository needs to keep.
#
# **By kind, not by name.** `user/Screenshot*` was the rule until 2026-09-18 and it only ever
# matched what his phone happens to call a file; four screenshots named `9tDUM-wZ.jpg` and one saved
# from a browser walked straight past it into a merge commit. An image in `user/` is a bug report
# whatever it is called.
#
# The music files in `user/` stay tracked: those are test material the checks and probes are run
# against.
#user/*.png
#user/*.jpg
#user/*.jpeg
#user/*.webp
#user/tests/
user/**

# The owner's working notes for an unattended run: his, not the project's record.
GOAL.md
